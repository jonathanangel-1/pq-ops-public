{
  "schemaVersion": "truth-precedence-policy-v1",
  "policyVersion": "pikiio-shipment-precedence-2026-07-09-v1",
  "description": "Deterministic conflict resolution for accepted shipment claims. Supersession is applied before this policy; newer event meaning wins before same-time evidence quality.",
  "criteria": [
    "event_time",
    "subject_specificity",
    "responsible_actor",
    "evidence_directness",
    "source_class",
    "confidence",
    "captured_at",
    "stable_identifier"
  ],
  "eventTime": {
    "fields": ["occurredAt", "capturedAt", "recordedAt"],
    "basisRanks": {
      "occurredAt": 300,
      "capturedAt": 200,
      "recordedAt": 100,
      "unknown": 0
    }
  },
  "subjectSpecificity": {
    "shipment": 300,
    "workgroup": 200,
    "connection": 100,
    "unknown": 0
  },
  "sourceClasses": {
    "operator": { "rank": 500, "label": "operator-recorded source evidence" },
    "direct_document_or_pod": { "rank": 450, "label": "direct document or POD" },
    "gmail_parsed_message": { "rank": 350, "label": "parsed Gmail message" },
    "tms": { "rank": 250, "label": "TMS source record" },
    "tracking": { "rank": 200, "label": "carrier tracking source event" },
    "unknown": { "rank": 0, "label": "unclassified accepted evidence" }
  },
  "evidenceDirectness": {
    "signed_document": 700,
    "direct_system_event": 650,
    "direct_actor_statement": 600,
